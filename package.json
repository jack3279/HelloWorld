{
  "name": "text-to-lottie",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "game": "vite --open /game/",
    "build": "tsc -b && vite build",
    "build:steve": "node scripts/build-steve-lottie.mjs",
    "check:text-slots": "node --experimental-strip-types --test scripts/text-slot-unicode.test.mjs",
    "check:combat": "node --test scripts/combat.test.mjs",
    "check:steve-sprites": "node --test scripts/steve-platformer.test.mjs",
    "check:coin": "node --test scripts/coin-lottie.test.mjs",
    "check:zombie": "node --test scripts/zombie.test.mjs",
    "check:lava": "node --test scripts/lava.test.mjs",
    "check:water": "node --test scripts/water.test.mjs",
    "check:skeleton": "node --test scripts/skeleton.test.mjs",
    "check:spider": "node --test scripts/spider.test.mjs",
    "check:enderman": "node --test scripts/enderman.test.mjs",
    "check:creeper": "node --test scripts/creeper.test.mjs",
    "check:pig": "node --test scripts/pig.test.mjs",
    "check:cow": "node --test scripts/cow.test.mjs",
    "check:chicken": "node --test scripts/chicken.test.mjs",
    "check:sheep": "node --test scripts/sheep.test.mjs",
    "check:slime": "node --test scripts/slime.test.mjs",
    "check:mobs": "node --test scripts/skeleton.test.mjs scripts/spider.test.mjs scripts/enderman.test.mjs scripts/creeper.test.mjs scripts/pig.test.mjs scripts/cow.test.mjs scripts/chicken.test.mjs scripts/sheep.test.mjs scripts/slime.test.mjs",
    "check:hud": "node --test scripts/hud.test.mjs",
    "check:blocks": "node --test scripts/blocks.test.mjs",
    "check:items": "node --test scripts/items.test.mjs",
    "check:game": "node --test scripts/game-demo.test.mjs scripts/craft.test.mjs",
    "generate:steve": "node scripts/generate-steve-svg.mjs && node scripts/generate-steve-sprites.mjs && node scripts/generate-steve-lottie.mjs",
    "generate:coin": "node scripts/generate-coin-lottie.mjs",
    "generate:zombie": "node scripts/generate-zombie-svg.mjs && node scripts/generate-zombie-sprites.mjs && node scripts/generate-zombie-lottie.mjs",
    "generate:lava": "node scripts/generate-lava-svg.mjs && node scripts/generate-lava-lottie.mjs",
    "generate:water": "node scripts/generate-water-svg.mjs",
    "generate:skeleton": "node scripts/generate-skeleton.mjs",
    "generate:spider": "node scripts/generate-spider.mjs",
    "generate:enderman": "node scripts/generate-enderman.mjs",
    "generate:creeper": "node scripts/generate-creeper.mjs",
    "generate:pig": "node scripts/generate-pig.mjs",
    "generate:cow": "node scripts/generate-cow.mjs",
    "generate:chicken": "node scripts/generate-chicken.mjs",
    "generate:sheep": "node scripts/generate-sheep.mjs",
    "generate:slime": "node scripts/generate-slime.mjs",
    "generate:mobs": "node scripts/generate-skeleton.mjs && node scripts/generate-spider.mjs && node scripts/generate-enderman.mjs && node scripts/generate-creeper.mjs && node scripts/generate-pig.mjs && node scripts/generate-cow.mjs && node scripts/generate-chicken.mjs && node scripts/generate-sheep.mjs && node scripts/generate-slime.mjs",
    "generate:combat": "npm run generate:steve && npm run generate:zombie && npm run generate:mobs",
    "generate:hud": "node scripts/generate-hud-svg.mjs && node scripts/generate-hud-lottie.mjs",
    "generate:blocks": "node scripts/generate-blocks-svg.mjs && node scripts/generate-blocks-lottie.mjs",
    "generate:items": "node scripts/generate-items-svg.mjs && node scripts/generate-items-lottie.mjs",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-canvaskit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.11",
    "@solidjs/router": "^0.16.1",
    "canvaskit-wasm": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.18.0",
    "shadcn": "^4.11.0",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-solid-svg": "^0.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.9.2",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  }
}
